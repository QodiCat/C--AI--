# DATABASE_URL 非空时优先；留空则使用下面的 POSTGRES_* 配置。
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ai_closet
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=ai_closet
POSTGRES_SSLMODE=disable
SEED_DEMO_DATA=false

AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-plus

# OSS 上传和读取凭据；仅保存在后端环境中。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 使用目标私有 Bucket 的实际地域。
ALIYUN_OSS_REGION=oss-cn-shanghai
ALIYUN_OSS_BUCKET=
# 视觉智能平台商品分割凭据，与 OSS 凭据独立。
ALIYUN_VIAPI_ACCESS_KEY_ID=
ALIYUN_VIAPI_ACCESS_KEY_SECRET=

# SMTP (implicit TLS)
SMTP_SERVER=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

APP_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8080
AI_API_BASE_URL=
AI_API_KEY=
