PUBLIC_ORIGIN=https://closet.example.com
WEB_PORT=80

# Compose 内置 PostgreSQL；必须设置密码。数据库端口不对外公开。
POSTGRES_DB=ai_closet
POSTGRES_USER=ai_closet
POSTGRES_PASSWORD=123456
# 使用服务器已有 PostgreSQL 时填写完整 DSN（优先于内置连接）。
# DATABASE_URL=host=db.example.com port=5432 user=ai_closet password=... dbname=ai_closet sslmode=verify-full
DATABASE_URL=
SEED_DEMO_DATA=false

AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-plus

# 阿里云视觉智能平台商品分割；仅保存在后端环境中。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 必须使用上海地域的私有 Bucket。
ALIYUN_OSS_REGION=oss-cn-shanghai
ALIYUN_OSS_BUCKET=
# 可单独配置 OSS RAM 凭据；留空时复用上面的后端阿里云凭据。
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# SMTP (implicit TLS)
SMTP_SERVER=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
